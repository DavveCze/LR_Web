# ==========================================
# Vercel Environment Variables (Frontend)
# ==========================================
# URL vašeho Convex deploymentu (získáte po spuštění npx convex dev / deploy)
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Volitelná externí URL pro fallback starého REST API (v produkci na Vercelu nevyužito)
# VITE_API_URL=


# ==========================================
# Convex Dashboard Environment Variables (Backend)
# Nastavuje se v: https://dashboard.convex.dev -> váš projekt -> Settings -> Environment Variables
# ==========================================

# 1. Resend API klíč pro odesílání e-mailů (z https://resend.com/api-keys)
RESEND_API_KEY=re_1234567890

# 2. Cílový e-mail pro notifikace o nových zprávách z formuláře
NOTIFICATION_EMAIL=info@lr-dance.cz

# 3. Administrátorská hesla pro Convex backend
ADMIN_PASSWORD=silne_heslo_admina_2026
OWNER_PASSWORD=silne_heslo_majitele_2026

# 4. Tajný klíč pro Convex Auth JWT podepisování (vygeneruje npx convex dev)
# CONVEX_AUTH_SECRET=...
# CONVEX_SITE_URL=https://your-domain.cz
